@@ -0,0 +1,87 @@
+import { describe, expect, it } from "vitest";
+import {
+  activeSpicyLine,
+  parseSpicyLyrics,
+  syllableProgress,
+} from "./spicyLyrics";
+
+const vocal = (start = 1, end = 3) => ({
+  StartTime: start,
+  EndTime: end,
+  Syllables: [
+    { Text: "Hel", StartTime: start, EndTime: start + 0.5, IsPartOfWord: true },
+    { Text: "lo", StartTime: start + 0.5, EndTime: start + 1 },
+    { Text: "world", StartTime: start + 1, EndTime: end },
+  ],
+});
+describe("Spicy Lyrics", () => {
+  it("joins syllables and retains background and duet timing", () => {
+    const parsed = parseSpicyLyrics({
+      Type: "Syllable",
+      source: "spicy_lyrics",
+      Content: [
+        {
+          Type: "Vocal",
+          Lead: vocal(),
+          Background: [vocal(2, 4)],
+          OppositeAligned: true,
+        },
+      ],
+    });
+    expect(parsed.lines[0].lead.text).toBe("Hello world");
+    expect(parsed.lines[0].opposite).toBe(true);
+    expect(parsed.lines[0].background[0].end).toBe(4);
+    expect(activeSpicyLine(parsed.lines, 3.5)).toBe(0);
+  });
+  it("parses line and static sync modes without fabricating word timing", () => {
+    const line = parseSpicyLyrics({
+      Type: "Line",
+      Content: [{ Type: "Vocal", Text: "Example", StartTime: 1, EndTime: 2 }],
+    });
+    expect(line.lines[0].lead.syllables).toEqual([]);
+    expect(
+      parseSpicyLyrics({ Type: "Static", Lines: [{ Text: "Example" }] })
+        .lines[0].lead.text,
+    ).toBe("Example");
+  });
+  it("skips interludes and malformed timing and rejects empty responses", () => {
+    expect(() =>
+      parseSpicyLyrics({
+        Type: "Line",
+        Content: [
+          { Type: "Interlude", StartTime: 0, EndTime: 1 },
+          { Type: "Vocal", Text: "Bad", StartTime: 3, EndTime: 2 },
+        ],
+      }),
+    ).toThrow("Empty");
+    expect(() => parseSpicyLyrics(null)).toThrow("Unsupported");
+  });
+  it("preserves credits but does not turn unsafe URLs into links", () => {
+    const data = parseSpicyLyrics({
+      Type: "Static",
+      Lines: [{ Text: "Example" }],
+      UploadAttribution: {
+        Uploader: { username: "Alice", url: "javascript:alert(1)" },
+        Maker: { username: "Bob", url: "https://spicylyrics.org/uid/123" },
+      },
+    });
+    expect(data.uploader).toEqual({ name: "Alice", url: undefined });
+    expect(data.maker?.url).toBe("https://spicylyrics.org/uid/123");
+  });
+  it("handles seeks and zero-duration syllables", () => {
+    expect(syllableProgress(0, 1, 2)).toBe(0);
+    expect(syllableProgress(1.5, 1, 2)).toBe(50);
+    expect(syllableProgress(4, 1, 2)).toBe(100);
+    expect(syllableProgress(1, 1, 1)).toBe(100);
+    const { lines } = parseSpicyLyrics({
+      Type: "Line",
+      Content: [
+        { Type: "Vocal", Text: "A", StartTime: 1, EndTime: 2 },
+        { Type: "Vocal", Text: "B", StartTime: 4, EndTime: 5 },
+      ],
+    });
+    expect(activeSpicyLine(lines, 4.5)).toBe(1);
+    expect(activeSpicyLine(lines, 1.5)).toBe(0);
+    expect(activeSpicyLine(lines, 0)).toBe(-1);
+  });
+});
