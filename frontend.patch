+}
+.spicy-line.active,
+.spicy-line.static {
+  opacity: 1;
+}
+.spicy-line.active {
+  transform: scale(1.035);
+}
+.spicy-line.opposite {
+  text-align: right;
+  transform-origin: right center;
+}
+.spicy-background {
+  font-size: 0.65em;
