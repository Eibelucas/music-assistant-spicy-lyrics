+          <p v-if="line.lead.translation" class="spicy-translation">
+            {{ line.lead.translation }}
+          </p>
+        </div>
+      </div>
+      <footer class="spicy-credit">
+        {{ $t("spicy_lyrics_source") }} {{ spicySourceName(lyrics.source) }}
+        <template v-if="lyrics.uploader">
+          · {{ $t("spicy_lyrics_uploader") }}
+          <a
+            v-if="lyrics.uploader.url"
+            :href="lyrics.uploader.url"
+            target="_blank"
+            rel="noopener noreferrer"
+            >{{ lyrics.uploader.name }}</a
+          >
+          <span v-else>{{ lyrics.uploader.name }}</span>
+        </template>
+        <template v-if="lyrics.maker">
+          · {{ $t("spicy_lyrics_maker") }}
+          <a
+            v-if="lyrics.maker.url"
+            :href="lyrics.maker.url"
+            target="_blank"
+            rel="noopener noreferrer"
+            >{{ lyrics.maker.name }}</a
+          >
+          <span v-else>{{ lyrics.maker.name }}</span>
+        </template>
+      </footer>
