new file mode 100644
--- /dev/null
+++ b/src/composables/lyrics/useSpicyLyrics.ts
@@ -0,0 +1,89 @@
+import {
+  computed,
+  onScopeDispose,
+  ref,
+  shallowRef,
+  watch,
+  type Ref,
+} from "vue";
+import { parseSpicyLyrics, type SpicyLyrics } from "@/helpers/spicyLyrics";
+import api from "@/plugins/api";
+import { store } from "@/plugins/store";
+import { MediaType } from "@/plugins/api/interfaces";
+
+interface SpicyResult {
+  status: "ready" | "no_lyrics" | "unsupported_track" | "no_track";
+  queue_item_id: string | null;
+  lyrics: unknown;
+}
+
+export function useSpicyLyrics(enabled: Ref<boolean>) {
+  const available = computed(() =>
+    Object.values(api.providers).some(
+      (provider) => provider.domain === "spicy_lyrics" && provider.available,
+    ),
+  );
+  const lyrics = shallowRef<SpicyLyrics | null>(null);
+  const loading = ref(false);
+  const state = ref("no_track");
+  let generation = 0;
+
+  const load = async () => {
+    const current = ++generation;
+    lyrics.value = null;
+    loading.value = false;
+    const queue = store.activePlayerQueue;
+    const item = store.curQueueItem;
+    if (
+      !enabled.value ||
+      !available.value ||
+      !queue?.active ||
+      !item ||
+      item.media_item?.media_type !== MediaType.TRACK
+    ) {
+      state.value = available.value ? "no_track" : "not_configured";
+      return;
+    }
+    const itemId = item.queue_item_id;
+    loading.value = true;
+    try {
+      const result = await api.sendCommand<SpicyResult>(
+        "spicy_lyrics/get",
+        { queue_id: queue.queue_id },
+        { suppressGlobalError: true },
+      );
+      if (
+        current !== generation ||
+        store.curQueueItem?.queue_item_id !== itemId
+      )
+        return;
+      if (result.queue_item_id !== itemId) {
+        state.value = "track_changed";
+        return;
+      }
+      state.value = result.status;
+      if (result.status === "ready")
+        lyrics.value = parseSpicyLyrics(result.lyrics);
+    } catch {
+      if (current === generation) state.value = "error";
+    } finally {
+      if (current === generation) loading.value = false;
+    }
+  };
+
+  watch(
+    () => [
+      enabled.value,
+      available.value,
+      store.activePlayerQueue?.queue_id,
+      store.activePlayerQueue?.active,
+      store.curQueueItem?.queue_item_id,
+    ],
+    load,
+    { immediate: true },
+  );
+  onScopeDispose(() => {
+    generation++;
+  });
+  return { available, lyrics, loading, state, retry: load };
+}
