+++ b/src/composables/lyrics/useSpicyLyrics.test.ts
@@ -0,0 +1,82 @@
+import { describe, expect, it, vi, beforeEach } from "vitest";
+import { effectScope, nextTick, reactive, ref } from "vue";
+
+vi.mock("@/plugins/api", () => ({
+  default: {
+    providers: { spicy: { domain: "spicy_lyrics", available: true } },
+    sendCommand: vi.fn(),
+  },
+}));
+vi.mock("@/plugins/store", () => ({
+  store: reactive({
+    activePlayerQueue: { queue_id: "queue", active: true },
+    curQueueItem: { queue_item_id: "a", media_item: { media_type: "track" } },
+  }),
+}));
+import api from "@/plugins/api";
+import { store } from "@/plugins/store";
+import { useSpicyLyrics } from "./useSpicyLyrics";
+
+const result = (id: string, text: string) => ({
+  status: "ready",
+  queue_item_id: id,
+  lyrics: { Type: "Static", Lines: [{ Text: text }] },
+});
+async function settle() {
+  await nextTick();
+  await Promise.resolve();
+  await nextTick();
+}
+
+describe("queue-bound Spicy Lyrics loading", () => {
+  beforeEach(() => {
+    vi.mocked(api.sendCommand).mockReset();
+    store.curQueueItem!.queue_item_id = "a";
+    store.activePlayerQueue!.active = true;
+  });
+  it("does not fetch while the lyrics panel is hidden", () => {
+    const scope = effectScope();
+    scope.run(() => useSpicyLyrics(ref(false)));
+    expect(api.sendCommand).not.toHaveBeenCalled();
+    scope.stop();
+  });
+  it("discards a late result after the song changed", async () => {
+    let resolveFirst!: (value: unknown) => void;
+    vi.mocked(api.sendCommand).mockImplementationOnce(
+      () =>
+        new Promise((resolve) => {
+          resolveFirst = resolve;
+        }),
+    );
+    vi.mocked(api.sendCommand).mockResolvedValueOnce(result("b", "Second"));
+    const scope = effectScope();
+    const state = scope.run(() => useSpicyLyrics(ref(true)))!;
+    store.curQueueItem!.queue_item_id = "b";
+    await settle();
+    expect(state.lyrics.value?.lines[0].lead.text).toBe("Second");
+    resolveFirst(result("a", "First"));
+    await settle();
+    expect(state.lyrics.value?.lines[0].lead.text).toBe("Second");
+    scope.stop();
+  });
+  it("does not show an API result belonging to another queue item", async () => {
+    vi.mocked(api.sendCommand).mockResolvedValue(
+      result("different", "Wrong song"),
+    );
+    const scope = effectScope();
+    const state = scope.run(() => useSpicyLyrics(ref(true)))!;
+    await settle();
+    expect(state.lyrics.value).toBeNull();
+    expect(state.state.value).toBe("track_changed");
+    scope.stop();
+  });
+  it("shows a recoverable error when the API fails", async () => {
+    vi.mocked(api.sendCommand).mockRejectedValue(new Error("network"));
+    const scope = effectScope();
+    const state = scope.run(() => useSpicyLyrics(ref(true)))!;
+    await settle();
+    expect(state.state.value).toBe("error");
+    expect(state.loading.value).toBe(false);
+    scope.stop();
+  });
+});
