diff --git a/src/helpers/spicyLyrics.ts b/src/helpers/spicyLyrics.ts
new file mode 100644
--- /dev/null
+++ b/src/helpers/spicyLyrics.ts
@@ -0,0 +1,183 @@
+export interface SpicySyllable {
+  text: string;
+  start: number;
+  end: number;
+  spaceAfter: boolean;
+}
+
+export interface SpicyVocal {
+  text: string;
+  start: number;
+  end: number;
+  syllables: SpicySyllable[];
+  translation?: string;
+}
+
+export interface SpicyLine {
+  lead: SpicyVocal;
+  background: SpicyVocal[];
+  opposite: boolean;
+}
+
+export interface SpicyCredit {
+  name: string;
+  url?: string;
+}
+
+export interface SpicyLyrics {
+  type: "Syllable" | "Line" | "Static";
+  lines: SpicyLine[];
+  source: string;
+  uploader?: SpicyCredit;
+  maker?: SpicyCredit;
+}
+
+function object(value: unknown): Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+}
+
+function list(value: unknown): unknown[] {
+  return Array.isArray(value) ? value : [];
+}
+
+function time(value: unknown): number | undefined {
+  return typeof value === "number" && Number.isFinite(value) && value >= 0
+    ? value
+    : undefined;
+}
+
+function text(value: unknown): string {
+  return typeof value === "string" ? value : "";
+}
+
+function vocal(value: unknown): SpicyVocal | undefined {
+  const raw = object(value);
+  const syllables = list(raw.Syllables).flatMap((entry): SpicySyllable[] => {
+    const item = object(entry);
+    const start = time(item.StartTime);
+    const end = time(item.EndTime);
+    if (
+      start === undefined ||
+      end === undefined ||
+      end < start ||
+      !text(item.Text)
+    )
+      return [];
+    return [
+      {
+        text: text(item.Text),
+        start,
+        end,
+        spaceAfter: item.IsPartOfWord !== true,
+      },
+    ];
+  });
+  const start = time(raw.StartTime) ?? syllables[0]?.start;
+  const end = time(raw.EndTime) ?? syllables.at(-1)?.end;
+  const content =
+    text(raw.Text) ||
+    syllables
+      .map(
+        (item, index) =>
+          item.text +
+          (item.spaceAfter && index < syllables.length - 1 ? " " : ""),
+      )
+      .join("");
+  if (start === undefined || end === undefined || end < start || !content)
+    return;
+  return {
+    text: content,
+    start,
+    end,
+    syllables,
+    translation: text(raw.TranslatedText) || undefined,
+  };
+}
+
+function credit(value: unknown): SpicyCredit | undefined {
+  const raw = object(value);
+  const name = text(raw.username);
+  if (!name) return;
+  const url = text(raw.url);
+  return {
+    name,
+    url: /^https:\/\/spicylyrics\.org\/uid\/[A-Za-z0-9_-]+$/.test(url)
+      ? url
+      : undefined,
+  };
+}
+
+export function parseSpicyLyrics(value: unknown): SpicyLyrics {
+  const raw = object(value);
+  const type = raw.Type;
+  if (type !== "Syllable" && type !== "Line" && type !== "Static")
+    throw new Error("Unsupported Spicy Lyrics response");
+  const lines = list(type === "Static" ? raw.Lines : raw.Content)
+    .flatMap((entry): SpicyLine[] => {
+      const item = object(entry);
+      if (type === "Static") {
+        const content = text(item.Text);
+        return content
+          ? [
+              {
+                lead: { text: content, start: 0, end: 0, syllables: [] },
+                background: [],
+                opposite: false,
+              },
+            ]
+          : [];
+      }
+      if (item.Type !== "Vocal") return [];
+      const lead = vocal(type === "Syllable" ? item.Lead : item);
+      if (!lead) return [];
+      const background = list(item.Background).flatMap((group) => {
+        const parsed = vocal(group);
+        return parsed ? [parsed] : [];
+      });
+      return [{ lead, background, opposite: item.OppositeAligned === true }];
+    })
+    .sort((a, b) => a.lead.start - b.lead.start);
+  if (!lines.length) throw new Error("Empty Spicy Lyrics response");
+  const attribution = object(raw.UploadAttribution);
+  return {
+    type,
+    lines,
+    source: text(raw.source) || "unknown",
+    uploader: credit(attribution.Uploader),
+    maker: credit(attribution.Maker),
+  };
+}
+
+export function syllableProgress(
+  position: number,
+  start: number,
+  end: number,
+): number {
+  if (position < start) return 0;
+  if (end <= start || position >= end) return 100;
+  return ((position - start) / (end - start)) * 100;
+}
+
+export function activeSpicyLine(lines: SpicyLine[], position: number): number {
+  const active = lines.findIndex((line) =>
+    [line.lead, ...line.background].some(
+      (group) => position >= group.start && position < group.end,
+    ),
+  );
+  if (active >= 0) return active;
+  return lines.findLastIndex((line) => position >= line.lead.start);
+}
+
+export function spicySourceName(source: string): string {
+  return (
+    (
+      {
+        spicy_lyrics: "Spicy Lyrics",
+        apple_music: "Apple Music",
+        spotify: "Spotify",
+      } as Record<string, string>
+    )[source] || "Spicy Lyrics API"
+  );
+}
