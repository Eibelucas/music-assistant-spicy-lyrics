+
+<script setup lang="ts">
+import {
+  computed,
+  nextTick,
+  ref,
+  toRef,
+  watch,
+  type ComponentPublicInstance,
+} from "vue";
+import SpicyVocal from "@/components/SpicyVocal.vue";
+import { Button } from "@/components/ui/button";
+import { Spinner } from "@/components/ui/spinner";
+import { useSpicyLyrics } from "@/composables/lyrics/useSpicyLyrics";
+import { useLyricsElapsedTime } from "@/composables/lyrics/useLyricsElapsedTime";
+import { useLyricsOffset } from "@/composables/lyrics/useLyricsOffset";
+import {
+  activeSpicyLine,
+  spicySourceName,
+  type SpicyLine,
+} from "@/helpers/spicyLyrics";
+import { $t } from "@/plugins/i18n";
+import Color from "color";
+
+const props = withDefaults(
+  defineProps<{ enabled: boolean; textColor?: string }>(),
+  { textColor: "#FFFFFF" },
+);
+const enabled = toRef(props, "enabled");
+const unsungColor = computed(() => {
+  try {
+    return Color(props.textColor).alpha(0.35).string();
+  } catch {
+    return "#ffffff55";
+  }
+});
+const { lyrics, loading, state, retry } = useSpicyLyrics(enabled);
+const { elapsedTime } = useLyricsElapsedTime(enabled);
+const { offset } = useLyricsOffset();
+const position = computed(() => elapsedTime.value + offset.value);
+const activeIndex = computed(() =>
+  activeSpicyLine(lyrics.value?.lines || [], position.value),
+);
+const scrollRef = ref<HTMLElement | null>(null);
+const lineRefs: (HTMLElement | null)[] = [];
+function setLineRef(
+  element: Element | ComponentPublicInstance | null,
+  index: number,
+) {
+  lineRefs[index] = element instanceof HTMLElement ? element : null;
+}
+function isActive(line: SpicyLine) {
+  return [line.lead, ...line.background].some(
+    (group) => position.value >= group.start && position.value < group.end,
+  );
+}
+watch(lyrics, () => {
+  lineRefs.length = 0;
+});
+watch(activeIndex, async (index) => {
+  if (lyrics.value?.type === "Static") return;
+  await nextTick();
+  const container = scrollRef.value;
+  const element = lineRefs[index];
+  if (!container || !element) return;
+  const top =
+    element.offsetTop - container.offsetTop - container.clientHeight * 0.35;
+  container.scrollTo({
+    top: Math.max(0, top),
+    behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
+      ? "instant"
+      : "smooth",
+  });
+});
+</script>
